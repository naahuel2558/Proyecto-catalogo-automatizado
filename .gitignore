# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.backup

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel and local integrations
.vercel
whatsapp-auth-session
stitch_downloads

# typescript
**/*.tsbuildinfo
next-env.d.ts

# P0-001 — bases de datos locales y artefactos generados
# Nunca deben incorporarse a Git: contienen datos operativos del entorno local.
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.backup
*.sqlite
*.sqlite3
