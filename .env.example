# IA ENTRE PANES — variables de entorno
#
# Copiar a `.env` y completar. Este archivo se versiona; `.env` NO.
# Nunca escribir valores reales aca.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

# Conexion que usa la aplicacion en runtime.
#
# LOCAL      SQLite:      file:./dev.db
# PRODUCTION PostgreSQL:  postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
#
# En un proveedor serverless (Neon, Supabase, Vercel Postgres) usar aca la URL
# POOLED. El runtime de Vercel abre y cierra conexiones por invocacion y agota
# el limite de una conexion directa.
DATABASE_URL=

# Conexion DIRECTA, sin pooler. Solo la usan `prisma migrate` e introspeccion:
# el pooler en modo transaction no soporta los statements que emiten.
# Requerida unicamente cuando el proveedor distingue pooled/direct.
DIRECT_DATABASE_URL=

# Base contra la que corren las suites de test. Si esta definida, el guard
# `scripts/_guard-test-db.ts` la usa en lugar de DATABASE_URL.
# NUNCA apuntarla a produccion: las suites crean y ELIMINAN registros.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Autenticacion (NextAuth)
# ---------------------------------------------------------------------------

# Secreto de firma de los JWT. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL publica del despliegue. Local: http://localhost:3000
NEXTAUTH_URL=

# OAuth de Google. Opcional: sin estos valores solo funciona el login por
# email y contrasena.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
